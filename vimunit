# ---------------------------------------------------------------------------
# Keys
#
# In a :type line every character is a literal key, except backslash, which
# introduces either a special key in Vim's <> notation (\<Esc>, \<C-V>) or a
# literal backslash (\\). Keys are normalized to tokens: either a single
# character or a canonical special-key name in angle brackets.

_NAMED_KEYS = {
    "esc": "<Esc>", "escape": "<Esc>",
    "cr": "<CR>", "enter": "<CR>", "return": "<CR>",
    "nl": "<NL>", "newline": "<NL>", "lf": "<NL>", "linefeed": "<NL>",
    "bs": "<BS>", "backspace": "<BS>",
    "tab": "<Tab>",
    "del": "<Del>", "delete": "<Del>",
    "insert": "<Insert>", "ins": "<Insert>",
    "up": "<Up>", "down": "<Down>", "left": "<Left>", "right": "<Right>",
    "home": "<Home>", "end": "<End>",
    "pageup": "<PageUp>", "pagedown": "<PageDown>",
    "s-up": "<S-Up>", "s-down": "<S-Down>", "s-left": "<S-Left>", "s-right": "<S-Right>",
    "c-left": "<C-Left>", "c-right": "<C-Right>", "c-home": "<C-Home>", "c-end": "<C-End>",
    "s-tab": "<S-Tab>",
    "nul": "<Nul>", "c-@": "<Nul>",
    # Control characters that are the same byte as a named key.
    "c-[": "<Esc>", "c-m": "<CR>", "c-j": "<NL>", "c-i": "<Tab>",
    "c-]": "<C-]>", "c-\\": "<C-\\>", "c-^": "<C-^>", "c-_": "<C-_>",
    # Printable characters with names.
    "space": " ", "lt": "<", "gt": ">", "bslash": "\\", "bar": "|",
}
for _c in "abcdefghklnopqrstuvwxyz":
    _NAMED_KEYS["c-" + _c] = "<C-%s>" % _c.upper()
for _n in range(1, 13):
    _NAMED_KEYS["f%d" % _n] = "<F%d>" % _n

SPECIAL_KEY_TOKENS = sorted(set(v for v in _NAMED_KEYS.values() if len(v) > 1))


class KeyError_(ValueError):
    pass


def tokenize_keys(text):
    """Split the text of a :type line into key tokens."""
    tokens = []
    i = 0
    while i < len(text):
        c = text[i]
        if c != "\\":
            tokens.append(c)
            i += 1
            continue
        if i + 1 >= len(text):
            raise KeyError_("trailing backslash (write \\\\ for a literal backslash)")
        nxt = text[i + 1]
        if nxt == "\\":
            tokens.append("\\")
            i += 2
        elif nxt == "<":
            end = text.find(">", i + 2)
            # Allow <C->> style names: the name is at least one character.
            if end == i + 2:
                end = text.find(">", i + 3)
            if end < 0:
                raise KeyError_("unterminated \\<...> key name")
            name = text[i + 2:end]
            tok = _NAMED_KEYS.get(name.lower())
            if tok is None:
                raise KeyError_("unknown key name <%s>" % name)
            tokens.append(tok)
            i = end + 1
        else:
            raise KeyError_("unknown escape \\%s (use \\<...> for special keys, \\\\ for a backslash)" % nxt)
    return tokens


def keys_to_text(tokens):
    """The inverse of tokenize_keys, producing canonical :type text. Spaces
    are written literally, except at the start or end, where they would be
    lost (the parser skips whitespace after ":type", and editors strip
    trailing whitespace)."""
    out = []
    for i, t in enumerate(tokens):
        if len(t) > 1:
            out.append("\\" + t)
        elif t == "\\":
            out.append("\\\\")
        elif t == " " and (i == 0 or i == len(tokens) - 1):
            out.append("\\<Space>")
        else:
            out.append(t)
    return "".join(out)


