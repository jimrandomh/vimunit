# This file is part of vim-unit: Unit tests for vim imitators
#
# Putting with gp and gP (cursor left after the pasted text), and ]p, [p
# (putting lines with their indent adjusted to the current line).

:start Command gp and gP (charwise)
	|Lorem ipsum
:type yegp
	LLorem|orem ipsum
:type u0gP
	Lorem|Lorem ipsum
:type u03gp
	LLoremLoremLorem|orem ipsum
:end

:start Command gp (charwise, at the end of the line)
	Lorem |ipsum
:type yw$gp
	Lorem ipsumipsu|m
:type u$gP
	Lorem ipsuipsum|m
:end

:start Command gp (charwise, several lines)
	Lo|rem
	ipsum dolor
:type vjy
	Lo|rem
	ipsum dolor
:type 0gp
	Lrem
	ips|orem
	ipsum dolor
:end

:start Command gp and gP (linewise)
:set startofline
	|Lorem
	  ipsum
	dolor
:type yjgp
	Lorem
	Lorem
	  ipsum
	|  ipsum
	dolor
:type u2GgP
	Lorem
	Lorem
	  ipsum
	|  ipsum
	dolor
:type u2G2gp
	Lorem
	  ipsum
	Lorem
	  ipsum
	Lorem
	  ipsum
	|dolor
:end

:start Command gp (linewise, at the end of the buffer)
:set startofline
	Lo|rem
	ipsum
:type yyjgp
	Lorem
	ipsum
	|Lorem
:type gp
	Lorem
	ipsum
	Lorem
	|Lorem
:end

:start Command . after gp
:set startofline
	|Lorem
	ipsum
:type yygp
	Lorem
	Lorem
	|ipsum
:type .
	Lorem
	Lorem
	ipsum
	|Lorem
:type .
	Lorem
	Lorem
	ipsum
	Lorem
	|Lorem
:end

:start Command . after gP
:set startofline
	|Lorem
	ipsum
:type yyjgP
	Lorem
	Lorem
	|ipsum
:type .
	Lorem
	Lorem
	Lorem
	|ipsum
:end

:start Command ]p and [p (linewise, adjusting the indent)
:set startofline tabstop=8 shiftwidth=8 noexpandtab
	|bar();
	if (a) {
	    foo();
	}
:type yyjj]p
	bar();
	if (a) {
	    foo();
	    |bar();
	}
:type u[p
	bar();
	if (a) {
	    |bar();
	    foo();
	}
:type u]P
	bar();
	if (a) {
	    |bar();
	    foo();
	}
:end

:start Command ]p (several lines keep their relative indent)
:set startofline tabstop=8 shiftwidth=8 noexpandtab
	|if (b) {
	  x();
	}
	void f() {
	    foo();
	}
:type y2jG[p
	if (b) {
	  x();
	}
	void f() {
	    foo();
	|if (b) {
	  x();
	}
	}
:type uk]p
	if (b) {
	  x();
	}
	void f() {
	    foo();
	    |if (b) {
	      x();
	    }
	}
:end

:start Command ]p (indent made of tabs)
:set startofline tabstop=8 shiftwidth=8 noexpandtab
	|  x();
	    y();
	f() {
		g();
	}
:type yj4G]p
	  x();
	    y();
	f() {
		g();
		|x();
		  y();
	}
:end

:start Command ]p (charwise register, like p)
	|Lorem
	    ipsum
:type yej]p
	Lorem
	 Lore|m   ipsum
:type u[p
	Lorem
	Lore|m    ipsum
:end
