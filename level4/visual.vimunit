# This file is part of vim-unit: Unit tests for vim imitators
#
# Visual-mode commands (o, O, gv, X, Y, C, D, S, R, r, J, gJ, u, U, ~, <, >,
# p, P) in characterwise and linewise Visual mode, switching between Visual
# modes, and repeating Visual-mode changes with `.`.

:start Visual o and O (go to the other end)
	Lorem ip|sum dolor
	sit amet
:type vllohd
	Lorem i| dolor
	sit amet
:type vllo\<Esc>x
	Lorem i|dolor
	sit amet
:type 0vjOld
	L|it amet
:end

:start Visual v, V, CTRL-V (switch mode, keeping the selection)
:set startofline
	ab|cdef
	ghijkl
	mnopqr
:type vjl\<C-V>d
	ab|ef
	ghkl
	mnopqr
:type uvjlVd
	|mnopqr
:type ufc\<C-V>jlvd
	ab|kl
	mnopqr
:type ufcVjvd
	ab|jkl
	mnopqr
:end

:start Visual v, V, CTRL-V (pressing the same key again leaves Visual mode)
	ab|cdef
	ghijkl
:type vlvx
	abc|ef
	ghijkl
:type VjVx
	abcef
	ghi|kl
:type \<C-V>k\<C-V>x
	abc|f
	ghikl
:end

:start Visual y (cursor moves to the start of the selection)
	Lorem ipsum |dolor
	sit amet
:type vbyx
	Lorem |psum dolor
	sit amet
:type wvjyx
	Lorem psum |olor
	sit amet
:end

:start Visual $ (selection includes the end of the line)
	Lorem |ipsum
	dolor sit
:type v$d
	Lorem |dolor sit
:type u$v$yj0P
	Lorem ipsum
	|m
	dolor sit
:end

:start Visual gv (reselect, and exchange with the previous selection)
	Lorem |ipsum dolor sit
	amet
:type vll\<Esc>jgvd
	Lorem |um dolor sit
	amet
:type vl\<Esc>wvgvd
	Lorem | dolor sit
	amet
:end

:start Visual gv (after deleting the selection)
	Lorem |ipsum dolor sit
:type vlld
	Lorem |um dolor sit
:type gvd
	Lorem |dolor sit
:end

:start Visual gv (after p, selects the put text)
	|Lorem ipsum dolor
:type yiwwviwp
	Lorem Lore|m dolor
:type gvU
	Lorem |LOREM dolor
:end

:start Visual X, D and Y (whole lines)
:set startofline
	Lorem
	ip|sum
	dolor
	sit
:type vlX
	Lorem
	|dolor
	sit
:type vD
	Lorem
	|sit
:type vlYP
	Lorem
	|sit
	sit
:end

:start Visual C, S, R (change whole lines)
	Lorem ip|sum
	dolor sit
	amet
:type vlCnew\<Esc>
	ne|w
	dolor sit
	amet
:type jvSfoo\<Esc>
	new
	fo|o
	amet
:type kvjRbar\<Esc>
	ba|r
	amet
:end

:start Visual r (replace all selected characters)
	Lorem ip|sum
	dolor sit
:type vjr*
	Lorem ip|***
	*********
:end

:start Visual J and gJ (join at least two lines)
	Lo|rem
	    ipsum
	dolor
	sit
:type vgJ
	Lorem|    ipsum
	dolor
	sit
:type uvJ
	Lorem| ipsum
	dolor
	sit
:type jVjJ
	Lorem ipsum
	dolor| sit
:end

:start Visual ~, u, U (change case)
	Lorem IPsum Dolor
	Sit Am|et
:type vk~
	Lorem |ipSUM dOLOR
	sIT aMEt
:type vehu
	Lorem |ipsuM dOLOR
	sIT aMEt
:type VU
	|LOREM IPSUM DOLOR
	sIT aMEt
:end

:start Visual > and < with count (count is the number of shifts)
:set shiftwidth=2 expandtab startofline
	|Lorem
	ipsum
	dolor
:type vj3>
	      |Lorem
	      ipsum
	dolor
:type j.
	      Lorem
	            |ipsum
	      dolor
:type Vj2<
	      Lorem
	        |ipsum
	  dolor
:end

:start Visual p (replaced text goes into the unnamed register)
	|Lorem ipsum dolor
:type yiwwviwp
	Lorem Lore|m dolor
:type wviwp
	Lorem Lorem ipsu|m
:end

:start Visual P (does not change the unnamed register)
	|Lorem ipsum dolor
:type yiwwviwP
	Lorem Lore|m dolor
:type wviwP
	Lorem Lorem Lore|m
:end

:start Visual p (replace a characterwise selection with lines)
	|Lorem
	ipsum,dolor;sit
:type yyjfdviwp
	Lorem
	ipsum,
	|Lorem
	;sit
:end

:start Visual p (replace lines with characterwise text)
	Lorem |ipsum
	dolor sit
:type yiwjVp
	Lorem ipsum
	|ipsum
:end

:start Visual . (repeat on the same number of characters)
	|Lorem ipsum dolor
:type vllcX\<Esc>
	|Xem ipsum dolor
:type w.
	Xem |Xum dolor
:end

:start Visual . (repeat multi-line characterwise delete)
	Lo|rem ipsum
	dolor sit
	amet consectetur
	adipiscing elit
	sed do
:type vjd
	Lo|or sit
	amet consectetur
	adipiscing elit
	sed do
:type j.
	Loor sit
	am|piscing elit
	sed do
:end
