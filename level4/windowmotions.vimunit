:start Motion H and L (nostartofline keeps the column)
:window 20x6
:set scrolloff=0 nostartofline
	alpha
	bravo ch|arlie
	delta
	echo
	foxtrot golf
	hotel india
	juliet
:type L
	alpha
	bravo charlie
	delta
	echo
	foxtrot golf
	hotel in|dia
	juliet
:type H
	alph|a
	bravo charlie
	delta
	echo
	foxtrot golf
	hotel india
	juliet
:type 2L
	alpha
	bravo charlie
	delta
	echo
	foxtrot |golf
	hotel india
	juliet
:end

