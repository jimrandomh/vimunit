# This file is part of vim-unit: Unit tests for vim imitators
#
# Incrementing and decrementing numbers with CTRL-A and CTRL-X.

:start Command CTRL-A (number after the cursor)
	|Lorem 41 ipsum 8
:type \<C-A>
	Lorem 4|2 ipsum 8
:type \<C-A>
	Lorem 4|3 ipsum 8
:type w\<C-A>
	Lorem 43 ipsum |9
:type \<C-A>
	Lorem 43 ipsum 1|0
:type \<C-A>
	Lorem 43 ipsum 1|1
:end

:start Command CTRL-A (cursor in the middle of a number)
	Lorem 12|34 ipsum
:type \<C-A>
	Lorem 123|5 ipsum
:type hh\<C-X>
	Lorem 123|4 ipsum
:end

:start Command CTRL-A (no number at or after the cursor)
	Lorem 42 ip|sum
	17
:type \<C-A>
	Lorem 42 ip|sum
	17
:type \<C-A>x
	Lorem 42 ip|um
	17
:end

:start Command CTRL-X (count, crossing zero)
	Lorem |5 ipsum
:type 10\<C-X>
	Lorem -|5 ipsum
:type 3\<C-A>
	Lorem -|2 ipsum
:type 2\<C-A>
	Lorem |0 ipsum
:type \<C-X>
	Lorem -|1 ipsum
:end

:start Command CTRL-A (a dash before the number makes it negative)
	|2020-12-31
:type \<C-A>
	202|1-12-31
:type w\<C-A>
	2021-1|1-31
:type $\<C-A>
	2021-11-3|0
:type 31\<C-A>
	2021-11|1
:end

:start Command CTRL-A (number inside a word)
	|foo9bar
:type \<C-A>
	foo1|0bar
:type \<C-X>
	foo|9bar
:end

:start Command CTRL-A (hexadecimal keeps the case of the letters)
	|0x0e 0X0E 0xaF 0x09
:type \<C-A>
	0x0|f 0X0E 0xaF 0x09
:type w\<C-A>
	0x0f 0X0|F 0xaF 0x09
:type w\<C-A>
	0x0f 0X0F 0xB|0 0x09
:type w\<C-A>
	0x0f 0X0F 0xB0 0x0|a
:end

:start Command CTRL-X (hexadecimal width)
	|0x10 0x0100
:type \<C-X>
	0x0|f 0x0100
:type w2\<C-X>
	0x0f 0x00f|e
:end

:start Command CTRL-A (binary)
:set nrformats=bin,hex
	|0b0111 0B11
:type \<C-A>
	0b100|0 0B11
:type \<C-X>
	0b011|1 0B11
:type w\<C-A>
	0b0111 0B10|0
:end

:start Command CTRL-A (leading zeros without octal)
:set nrformats=bin,hex
	|007 0099
:type \<C-A>
	00|8 0099
:type \<C-A>
	00|9 0099
:type \<C-A>
	01|0 0099
:type w\<C-A>
	010 010|0
:type 101\<C-X>
	010 -000|1
:end

:start Command CTRL-A (leading zeros with octal)
:set nrformats=bin,octal,hex
	|007 08 -010
:type \<C-A>
	01|0 08 -010
:type w\<C-A>
	010 |9 -010
:type w\<C-A>
	010 9 -01|1
:end

:start Command . after CTRL-A (with and without a new count)
	|1 10 100
:type 5\<C-A>
	|6 10 100
:type .
	1|1 10 100
:type w.
	11 1|5 100
:type 2.
	11 1|7 100
:type w.
	11 17 10|2
:end

:start Command CTRL-A and g CTRL-A in Visual mode
:set startofline
	|0. Lorem
	0. ipsum
	0. dolor
:type VG\<C-A>
	|1. Lorem
	1. ipsum
	1. dolor
:type uVGg\<C-A>
	|1. Lorem
	2. ipsum
	3. dolor
:type uVG3g\<C-A>
	|3. Lorem
	6. ipsum
	9. dolor
:end
