# This file is part of vim-unit: Unit tests for vim imitators
#
# Bracket and tag text objects: i( a( ib ab, i[ a[, i{ a{ iB aB, i< a<, it at,
# with operators and in Visual mode.

:start Text objects i(, a), ib, ab (cursor inside)
	foo(bar, b|az) qux
:type di(
	foo(|) qux
:type uda)
	foo| qux
:type udib
	foo(|) qux
:type udab
	foo| qux
:end

:start Text object i( (cursor on a parenthesis)
	foo(bar) (b|az)
:type 0f(di(
	foo(|) (baz)
:type $di)
	foo() (|)
:end

:start Text object i( (nested parentheses, with count)
	f(a, g(b|c), d)
:type di(
	f(a, g(|), d)
:type ud2i(
	f(|)
:type ufcd3i(
	f(a, g(b|c), d)
:end

:start Text object i( (empty parentheses)
	foo(|) bar
:type di(
	foo(|) bar
:type ci(x\<Esc>
	foo(|x) bar
:end

:start Text object i( and a( (cursor before the brackets searches forward)
	f|oo(bar) baz
	qux [quux]
:type di(
	foo(|) baz
	qux [quux]
:type u0da(
	foo| baz
	qux [quux]
:type $di[
	foo baz
	qux [|]
:end

:start Text object i( (multi-line contents)
	foo(bar,
	    b|az) qux
:type di(
	foo(|) qux
:end

:start Text object i{ (lines between braces are deleted whole)
	if (x) {
	    fo|o();
	    bar();
	}
:type di{
	if (x) {
	|}
:end

:start Text object i{ (change lines between braces)
:set autoindent
	if (x) {
	    fo|o();
	    bar();
	}
:type ci{baz\<Esc>
	if (x) {
	    ba|z
	}
:end

:start Text object aB and iB (same as a{ and i{)
	x = {a: {b|: 1}, c: 2};
:type diB
	x = {a: {|}, c: 2};
:type udaB
	x = {a: |, c: 2};
:type u2diB
	x = {|};
:end

:start Text object i[ and a[
	x[a[|1], b]
:type di[
	x[a[|], b]
:type uda]
	x[a|, b]
:end

:start Text object i< and a<
	Vec<Opt<i|nt>> v;
:type di<
	Vec<Opt<|>> v;
:type uda>
	Vec<Opt|> v;
:end

:start Text object i( in Visual mode (repeating extends outward)
	f(a, g(b|c), d)
:type vi(i(d
	f(|)
:type ufbva(a(d
	|f
:end

:start Command yi( (cursor moves to the start)
	foo(bar b|az) qux
:type yi(P
	foo(bar ba|zbar baz) qux
:end

:start Commands gUi( and >i{
:set shiftwidth=2 expandtab startofline
	foo(b|ar) {
	baz
	}
:type gUi(
	foo(|BAR) {
	baz
	}
:type j>i{
	foo(BAR) {
	  |baz
	}
:end

:start Text object it and at
	<p>Lorem <b>ip|sum</b> dolor</p>
:type dit
	<p>Lorem <b>|</b> dolor</p>
:type udat
	<p>Lorem | dolor</p>
:end

:start Text object it (nested tags, with count)
	<div><p>Lo|rem</p> ipsum</div>
:type d2it
	<div>|</div>
:type ud2at
	|
:end

:start Text object it (cursor on a tag with attributes)
	|Lorem <a href="x.html">ipsum</a> dolor
:type fhdit
	Lorem <a href="x.html">|</a> dolor
:type udat
	Lorem | dolor
:end

:start Text object it in Visual mode (repeating includes the tags)
	<p>Lorem <b>ip|sum</b> dolor</p>
:type vititd
	<p>Lorem | dolor</p>
:type uvitititd
	<p>|</p>
:end

:start Text object it (empty element)
	|<p>Lorem <b></b> ipsum</p>
:type f>;citX\<Esc>
	<p>Lorem <b>|X</b> ipsum</p>
:end

:start Text object it (multi-line element)
	<ul>
	  <li>Lo|rem</li>
	  <li>ipsum</li>
	</ul>
:type d2it
	<ul>|</ul>
:end
