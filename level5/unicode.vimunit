# This file is part of vim-unit: Unit tests for vim imitators
#
# Non-ASCII text with options that have no counterpart in most other editors:
# 'delcombine', and the 'formatoptions' flags m and M.
#
# Combining characters are written decomposed: "é" is "e" followed by U+0301
# COMBINING ACUTE ACCENT.

:start Command x (with delcombine, deletes one combining mark at a time)
:set delcombine
	caf|é ạ́z é
:type x
	caf|e ạ́z é
:type x
	caf| ạ́z é
:type lx
	caf |ạz é
:type x
	caf |az é
:type x
	caf |z é
:type $x
	caf z| 
:end

:start Command J (formatoptions M, no space next to a multibyte character)
:set formatoptions=tcqM
	|日本語の
	テキスト
	abc
	漢字
:type J
	日本語の|テキスト
	abc
	漢字
:type J
	日本語のテキスト|abc
	漢字
:type J
	日本語のテキストabc|漢字
:end

# The "ạ́" is "a" followed by U+0323 and U+0301.
:start Insert <BS> (with delcombine, deletes one combining mark at a time)
:set delcombine
	cạ́|!
:type i\<BS>\<Esc>
	c|ạ!
:type a\<BS>\<BS>\<Esc>
	|c!
:end

:start Command gq (formatoptions m, break at a multibyte character)
:set textwidth=10 formatoptions=tcqm
	|日本語のテキストです
	abc
:type gqq
	日本語のテ
	|キストです
	abc
:end

:start Command gq (joining CJK lines, formatoptions m)
:set textwidth=10 formatoptions=tcqm
	|日本語の
	テキストです
:type gqj
	日本語の
	テキストで
	|す
:end

:start Command gq (joining CJK lines, formatoptions mM)
:set textwidth=10 formatoptions=tcqmM
	|日本語の
	テキストです
:type gqj
	日本語のテ
	|キストです
:end

:start Automatic wrapping with textwidth (multibyte text)
:set textwidth=10 formatoptions=tcqm
	|
:type i日本語のテキストです\<Esc>
	日本語のテ
	キストで|す
:type oéé éé éé éé\<Esc>
	日本語のテ
	キストです
	éé éé éé
	é|é
:end
