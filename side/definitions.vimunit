	int scale = 2;

	int helper(int n)
	{
	    return n * scale;
	}

	int main(void)
	{
	    int |total = helper(3);
	    return total;
	}
:type \<C-O>
	int scale = 2;

	int helper(int n)
	{
	    return n * scale;
	}

	int main(void)
	{
	    int total = helper(3);
	    return to|tal;
