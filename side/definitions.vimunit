:end

:start Definition gd (local variable)
:definition scale 1:5
:definition helper 3:5
:definition n 3:16
:definition main 8:5
:definition total 10:9
	int scale = 2;

	int helper(int n)
	{
	    return n * scale;
	}

	int main(void)
	{
	    int total = helper(3);
	    return to|tal;
	}
