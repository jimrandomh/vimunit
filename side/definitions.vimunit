:start Definition gd (function parameter)
:definition scale 1:5
:definition helper 3:5
:definition n 3:16
:definition main 8:5
:definition total 10:9
	int scale = 2;

	int helper(int n)
	{
	    return |n * scale;
	}

	int main(void)
	{
	    int total = helper(3);
	    return total;
	}
:type gd
	int scale = 2;

	int helper(int |n)
	{
	    return n * scale;
	}

	int main(void)
	{
	    int total = helper(3);
	    return total;
	}
:end

:start Definition gd (skips a match in a comment)
:definition scale 1:5
:definition main 3:5
:definition total 6:9
	int scale = 2;

	int main(void)
	{
	    // the total is scaled
	    int total = 3 * scale;
	    return |total;
	}
:type gd
	int scale = 2;

	int main(void)
	{
	    // the total is scaled
	    int |total = 3 * scale;
	    return total;
	}
:end

:start Definition gD (global declaration)
:definition scale 1:5
:definition main 3:5
:definition total 6:9
	int scale = 2;

	int main(void)
	{
	    // the total is scaled
	    int total = 3 * s|cale;
	    return total;
	}
:type gD
	int |scale = 2;

	int main(void)
	{
	    // the total is scaled
	    int total = 3 * scale;
	    return total;
	}
:type \<C-O>
	int scale = 2;

	int main(void)
	{
	    // the total is scaled
	    int total = 3 * s|cale;
	    return total;
	}
:end
