# This file is part of vim-unit: Unit tests for vim imitators
#
# Insert-mode commands: CTRL-W, CTRL-U, CTRL-H, <Del>, CTRL-A, CTRL-@,
# CTRL-R, CTRL-E, CTRL-Y, CTRL-V and CTRL-O.

:start Insert CTRL-W (delete the word and the whitespace before the cursor)
	foo bar  ba|z
:type A\<C-W>X\<Esc>
	foo bar  |X
:type A\<C-W>\<C-W>Y\<Esc>
	foo |Y
:end

:start Insert CTRL-W over punctuation
	call foo->ba|r(
:type A\<C-W>\<Esc>
	call foo->ba|r
:type A\<C-W>\<Esc>
	call foo-|>
:type A\<C-W>\<Esc>
	call fo|o
:type A\<C-W>\<Esc>
	call| 
:end

:start Insert CTRL-W in the middle of a word
	alpha be|ta
:type i\<C-W>X\<Esc>
	alpha |Xta
:end

:start Insert CTRL-W stops once at the start of the insert
	alpha be|ta
:type Agamma\<C-W>X\<Esc>
	alpha beta|X
:type Agamma\<C-W>\<C-W>Y\<Esc>
	alpha |Y
:end

:start Insert CTRL-W at the start of a line (joins lines)
	alpha
	be|ta
:type I\<C-W>X\<Esc>
	alpha|Xbeta
:end

:start Insert CTRL-U (delete the entered text, then the rest of the line)
	alpha be|ta gamma
:type A delta\<C-U>X\<Esc>
	alpha beta gamma|X
:type A delta\<C-U>\<C-U>Y\<Esc>
	|Y
:end

:start Insert CTRL-U before the end of the line
	alpha be|ta
:type i\<C-U>X\<Esc>
	|Xta
:end

:start Insert CTRL-H and <BS> (joining lines)
	alpha
	be|ta
:type I\<BS>\<BS>X\<Esc>
	alph|Xbeta
:type A\<C-H>\<C-H>Y\<Esc>
	alphXbe|Y
:end

:start Insert <Del> (joining lines at the end)
	al|pha
	beta
:type i\<Del>\<Del>X\<Esc>
	al|Xa
	beta
:type A\<Del>Y\<Esc>
	alXa|Ybeta
:end

:start Insert CTRL-A (insert the previously inserted text)
	al|pha
:type ifoo\<Esc>
	alfo|opha
:type $a\<C-A>X\<Esc>
	alfoophafoo|X
:type 0i\<C-A>\<Esc>
	foo|XalfoophafooX
:end

:start Insert CTRL-@ (insert the previously inserted text and stop)
	al|pha
:type ifoo\<Esc>
	alfo|opha
:type $a\<Nul>
	alfoophafo|o
:end

:start Insert CTRL-R (insert a register)
	alpha be|ta
:type yiw
	alpha |beta
:type A \<C-R>"\<Esc>
	alpha beta bet|a
:type 0i\<C-R>0-\<Esc>
	beta|-alpha beta beta
:end

:start Insert CTRL-R with a linewise register
	al|pha
	beta
:type yy
	al|pha
	beta
:type jA-\<C-R>"X\<Esc>
	alpha
	beta-alpha
	|X
:end

:start Insert CTRL-R with the . and - registers
	alpha be|ta
:type ifoo\<Esc>
	alpha befo|ota
:type x
	alpha befo|ta
:type A \<C-R>.\<C-R>-\<Esc>
	alpha befota foo|o
:end

:start Insert CTRL-E and CTRL-Y (copy from the line below and above)
	abcdef
	|
	uvw
:type i\<C-Y>\<C-Y>\<C-E>\<C-E>\<Esc>
	abcdef
	ab|w
	uvw
:type A\<C-E>\<C-Y>\<C-Y>\<Esc>
	abcdef
	abwd|e
	uvw
:end

:start Insert CTRL-V with a decimal, octal or hex code
	|x
:type i\<C-V>065\<C-V>66\<C-V>o103\<C-V>x44\<C-V>X45-\<Esc>
	ABCDE|-x
:end

:start Insert CTRL-O (run one Normal-mode command)
	alpha be|ta
:type i\<C-O>0X\<Esc>
	|Xalpha beta
:type a\<C-O>$Y\<Esc>
	Xalpha beta|Y
:type A\<C-O>2bZ\<Esc>
	|ZXalpha betaY
:end

:start Insert CTRL-O at the end of the line
	alpha be|ta
	gamma
:type Afoo\<C-O>maX\<Esc>
	alpha betafoo|X
	gamma
:type A\<C-O>jY\<Esc>
	alpha betafooX
	gamma|Y
:end

:start Insert CTRL-O with an operator
	alpha be|ta gamma
:type a\<C-O>dwX\<Esc>
	alpha bet|Xgamma
:type 0i\<C-O>D\<Esc>
	|
:end

:start Insert CTRL-O and undo
	al|pha
:type ifoo\<C-O>lbar\<Esc>
	alfoopba|rha
:type u
	alfoop|ha
:type u
	al|pha
:end

:start Insert CTRL-O and . (repeats the text typed after it)
	al|pha beta
:type ifoo\<C-O>lbar\<Esc>
	alfoopba|rha beta
:type w.
	alfoopbarha ba|rbeta
:end
