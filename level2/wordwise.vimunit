# This file is part of vim-unit: Unit tests for vim imitators

:start Motion w (next word)
	Lo|rem ipsum-dolor--
	sit amet consectetur.
:type w
	Lorem |ipsum-dolor--
	sit amet consectetur.
:type w
	Lorem ipsum|-dolor--
	sit amet consectetur.
:type w
	Lorem ipsum-|dolor--
	sit amet consectetur.
:type 2w
	Lorem ipsum-dolor--
	|sit amet consectetur.
:type 100w
	Lorem ipsum-dolor--
	sit amet consectetur|.
:end

:start Motion W (next WORD)
	Lo|rem ipsum-dolor--
	  s!,1.425it amet consectetur
:type 2W
	Lorem ipsum-dolor--
	  |s!,1.425it amet consectetur
:type W
	Lorem ipsum-dolor--
	  s!,1.425it |amet consectetur
:type hW
	Lorem ipsum-dolor--
	  s!,1.425it |amet consectetur
:type 100W
	Lorem ipsum-dolor--
	  s!,1.425it amet consectetu|r
:end

