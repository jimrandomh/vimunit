# This file is part of vim-unit: Unit tests for vim imitators
#
# Marks: m, ' and `.

:start Marks (m,',`)
:set startofline
	Lo|rem
	ipsum
	dolor
	sit amet
:type ma'a
	|Lorem
	ipsum
	dolor
	sit amet
:type `a
	Lo|rem
	ipsum
	dolor
	sit amet
:type $d`a
	Lo|m
	ipsum
	dolor
	sit amet
:type jd'a
	|dolor
	sit amet
:type u
	|Lom
	ipsum
	dolor
	sit amet
:type d'a
	|ipsum
	dolor
	sit amet
:end

:start Mark ' (jumps to the first non-blank)
	    Lo|rem
	ipsum
:type maj
	    Lorem
	ipsu|m
:type 'a
	    |Lorem
	ipsum
:type j`a
	    Lo|rem
	ipsum
:end

:start Mark ' (linewise) and ` (charwise) with y
	Lorem ip|sum-dolor
	sit
:type maw
	Lorem ipsum|-dolor
	sit
:type y`a$p
	Lorem ipsum-dolorsu|m
	sit
:type jy'aP
	|Lorem ipsum-dolorsum
	sit
	Lorem ipsum-dolorsum
	sit
:end

:start Mark ` with an operator (exclusive)
	Lo|rem ipsum dolor
:type ma2w
	Lorem ipsum |dolor
:type d`a
	Lo|dolor
:type ma0c`aX\<Esc>
	|Xdolor
:end

:start Mark (not set, fails)
	Lo|rem
	ipsum
:type 'b
	Lo|rem
	ipsum
:type `b
	Lo|rem
	ipsum
:type jd'b
	Lorem
	ip|sum
:end

:start Mark (moves when lines are inserted or deleted above it)
	Lorem
	ip|sum
	dolor
:type ma
	Lorem
	ip|sum
	dolor
:type kyyP
	|Lorem
	Lorem
	ipsum
	dolor
:type `a
	Lorem
	Lorem
	ip|sum
	dolor
:type kdd'a
	Lorem
	|ipsum
	dolor
:end

:start Mark (column does not move when text is inserted before it)
	Lorem ip|sum
:type ma0
	|Lorem ipsum
:type iXX\<Esc>`a
	XXLorem |ipsum
:end

:start Mark (on a deleted line is removed)
:set startofline
	Lorem
	ip|sum
	dolor
:type ma
	Lorem
	ip|sum
	dolor
:type dd
	Lorem
	|dolor
:type k'a
	|Lorem
	dolor
:end

:start Mark (restored by undo)
:set startofline
	Lorem
	ip|sum
	dolor
:type madd
	Lorem
	|dolor
:type u
	Lorem
	|ipsum
	dolor
:type k`a
	Lorem
	ip|sum
	dolor
:end

:start Mark (uppercase marks)
	Lo|rem
	ipsum
	dolor
:type mAj
	Lorem
	ip|sum
	dolor
:type `A
	Lo|rem
	ipsum
	dolor
:type jjd'A
	|
:end
