# This file is part of vim-unit: Unit tests for vim imitators

:start Motion | (go to column)
	Lo|rem ipsum dolor
:type |
	|Lorem ipsum dolor
:type 10|
	Lorem ips|um dolor
:type 100|
	Lorem ipsum dolo|r
:end

# These should be synonyms. Also a synonym is ^M, but that's only because
# terminals don't distinguish it from <CR>; it's sensible to remap it to
# something else if you're not in a terminal.
:start Motion <CR>/+
:set startofline
	Lo|rem
	 ipsum
	dolor
:type \<CR>
	Lorem
	 |ipsum
	dolor
:type +
	Lorem
	 ipsum
	|dolor
:type kk2+ll
	Lorem
	 ipsum
	do|lor
:type +
	Lorem
	 ipsum
	do|lor
:type kd+
	|Lorem
:end

:start Motion _
:set startofline
	Lo|rem
	  ipsum
	dolor
:type _
	|Lorem
	  ipsum
	dolor
:type 2_
	Lorem
	  |ipsum
	dolor
:type d_
	Lorem
	|dolor
:end

:start Motion -
	Lorem
	  ipsum
	dolo|r
:type -
	Lorem
	  |ipsum
	dolor
:type j2-
	|Lorem
	  ipsum
	dolor
:type jd-
	|dolor
:type d-
	|dolor
:end

# The <space> motion is like l, except that it wraps (under the default value
# for vim's 'whichwrap' option.)
:start Motion <space> (right, wrapping)
:set whichwrap=b,s
	Lor|em
	  ipsum
	dolor
:type \<Space>
	Lore|m
	  ipsum
	dolor
:type 2\<Space>
	Lorem
	 | ipsum
	dolor
:type 100\<Space>
	Lorem
	  ipsum
	dolo|r
:end

:start Motion <bs> (left, wrapping)
:set whichwrap=b,s
	Lorem
	  ipsum
	|dolor
:type \<BS>
	Lorem
	  ipsu|m
	dolor
:type 100\<BS>
	|Lorem
	  ipsum
	dolor
:end

:start Motions t,T,f,F (to char)
	Prevline
	|Lorem ipsum dolor
	Nextline
:type ti
	Prevline
	Lorem| ipsum dolor
	Nextline
:type toto
	Prevline
	Lorem ipsum |dolor
	Nextline
:type 03to
	Prevline
	Lorem ipsum do|lor
	Nextline
:type Tr
	Prevline
	Lor|em ipsum dolor
	Nextline
:type 2fo
	Prevline
	Lorem ipsum dol|or
	Nextline
:type Fp
	Prevline
	Lorem i|psum dolor
	Nextline
:type tN
	Prevline
	Lorem i|psum dolor
	Nextline
:type TP
	Prevline
	Lorem i|psum dolor
	Nextline
:end

:start Motions ,; (repeat last tTfF motion or its inverse)
	|Lorem ipsum em me lorem
:type fm;
	Lorem ipsu|m em me lorem
:type ,
	Lore|m ipsum em me lorem
:type 3;
	Lorem ipsum em |me lorem
:type 2,
	Lorem ipsu|m em me lorem
:type Fm
	Lore|m ipsum em me lorem
:type 2,
	Lorem ipsum e|m me lorem
:type ;
	Lorem ipsu|m em me lorem
:type tm
	Lorem ipsum |em me lorem
:type ;
	Lorem ipsum em| me lorem
:type ,
	Lorem ipsum| em me lorem
:type Tm
	Lorem ipsum| em me lorem
:type 2;
	Lorem| ipsum em me lorem
:type ,
	Lorem ips|um em me lorem
:type hhdhxuiasdf\<Esc>
	Lorem asd|fpsum em me lorem
:type ;
	Lorem| asdfpsum em me lorem
:end

# This doesn't even begin to get into the weird special cases, like matching
# /* */ comments, #ifdef/#endif, delimiters preceded by backslashes and
# delimiters inside what look like string literals (all of which are handled by
# vim). These may be tested in later levels.
:start Motion % (matching delimiter, for ({[ and )}])
:set tabstop=4
	if|(arr[getIdx()]) {
		act();
	}
:type %
	if(arr[getIdx()]|) {
		act();
	}
:type %
	if|(arr[getIdx()]) {
		act();
	}
:type 0%
	if(arr[getIdx()]|) {
		act();
	}
:type l%
	if(arr[getIdx()]) {
		act();
	|}
:type k$h%
	if(arr[getIdx()]) {
		act|();
	}
:type kh%
	if(arr[getIdx()|]) {
		act();
	}
:end

:start Motions ge,gE (back to end of word)
	Lorem ipsum dolo|r
	si!,3.4@#$(t amet
:type ge
	Lorem ipsu|m dolor
	si!,3.4@#$(t amet
:type j$2gE
	Lorem ipsum dolo|r
	si!,3.4@#$(t amet
:end

:start Motion % (from a non-bracket character, uses the next bracket in the line)
	|if (a[1]) {
	}
:type %
	if (a[1]|) {
	}
:type %
	if |(a[1]) {
	}
:type 0fa%
	if (a[1|]) {
	}
:type $h%
	if (a[1]) {
	|}
:end

:start Motion % (with no bracket after the cursor fails)
	foo(bar) b|az
	(dolor)
:type %
	foo(bar) b|az
	(dolor)
:end

:start Motion % (unmatched bracket fails)
	Lorem |(ipsum
	dolor
:type %
	Lorem |(ipsum
	dolor
:end

:start Operator d with % (inclusive)
	x = |foo(a, b) + 1
:type d%
	x = | + 1
:type uf(d%
	x = foo| + 1
:end

:start Operator d with % (across lines)
	foo|(
	    bar,
	    baz)
	qux
:type d%
	fo|o
	qux
:end

:start Motion | (remembers the column it asked for)
	|Lorem
	ipsum dolor sit
:type 8|
	Lore|m
	ipsum dolor sit
:type j
	Lorem
	ipsum d|olor sit
:type k100|j
	Lorem
	ipsum dolor si|t
:end

:start Motion | (counts screen columns, tabs are wide)
:set tabstop=8
		Lo|rem ipsum
:type 1|
	|	Lorem ipsum
:type 5|
	|	Lorem ipsum
:type 10|
		L|orem ipsum
:end

:start Operator d with | (exclusive, either direction)
	Lorem ipsum dol|or sit
:type d3|
	Lo|or sit
:type d6|
	Lo|sit
:end

:start Motions + and - (count larger than the number of lines)
	|Lorem
	  ipsum
	    dolor
:type 100+
	Lorem
	  ipsum
	    |dolor
:type 100-
	|Lorem
	  ipsum
	    dolor
:type -
	|Lorem
	  ipsum
	    dolor
:end

:start Operators d and c with + and -
:set noautoindent startofline
	Lorem
	  ip|sum
	dolor
	sit
	amet
	consectetur
	adipiscing
:type d+
	Lorem
	|sit
	amet
	consectetur
	adipiscing
:type d-
	|amet
	consectetur
	adipiscing
:type c2+X\<Esc>
	|X
:end

:start Motion _ (with operators and counts)
:set noautoindent startofline
	|Lorem
	  ipsum
	dolor
	sit
:type j$d2_
	Lorem
	|sit
:type c_X\<Esc>
	Lorem
	|X
:type 5d_
	Lorem
	|X
:end

:start Operator d with <CR> (linewise)
:set startofline
	Lorem
	ip|sum
	dolor
	sit
:type d\<CR>
	Lorem
	|sit
:type kd5\<CR>
	|
:end

:start Operator d with <Space> (the end of the line counts as a character)
:set whichwrap=b,s
	Lor|em
	ipsum
:type d2\<Space>
	Lo|r
	ipsum
:type d3\<Space>
	Lo|psum
:end

:start Operator d with <BS> (at the start of a line)
:set whichwrap=b,s
	Lorem
	|ipsum
	dolor
:type d\<BS>
	Lorem|ipsum
	dolor
:type j0d2\<BS>
	Loremipsu|dolor
:end

:start Motion ge (stops on empty lines)
	Lorem
	
	|ipsum
:type ge
	Lorem
	|
	ipsum
:type ge
	Lore|m

	ipsum
:type ge
	|Lorem

	ipsum
:end

:start Operator d with ge (inclusive)
	Lorem ip|sum dolor
:type dge
	Lore|um dolor
:type w2dge
	|olor
:end

:start Motions gE and ge (over punctuation and across lines)
	Lorem ip-sum
	|dolor
:type gE
	Lorem ip-su|m
	dolor
:type j2gE
	Lore|m ip-sum
	dolor
:type j3ge
	Lorem i|p-sum
	dolor
:end
