# This file is part of vim-unit: Unit tests for vim imitators

:start Motion j (the column is counted in screen cells across a tab)
:set tabstop=8
	Lorem ipsum |dolor
		sit amet
:type j
	Lorem ipsum dolor
		sit |amet
:type k
	Lorem ipsum |dolor
		sit amet
:end

:start Motion j (onto a tab, then on to the remembered column)
:set tabstop=8
	Lor|em
		ipsum
	dolor
:type j
	Lorem
	|	ipsum
	dolor
:type j
	Lorem
		ipsum
	dol|or
:type kk
	Lor|em
		ipsum
	dolor
:end

# This doesn't even begin to get into the weird special cases, like matching
# /* */ comments, #ifdef/#endif, delimiters preceded by backslashes and
# delimiters inside what look like string literals (all of which are handled by
# vim). These may be tested in later levels.
:start Motion % (matching delimiter, for ({[ and )}])
:set tabstop=4 shiftwidth=4
	if|(arr[getIdx()]) {
		act();
	}
:type %
	if(arr[getIdx()]|) {
		act();
	}
:type %
	if|(arr[getIdx()]) {
		act();
	}
:type 0%
	if(arr[getIdx()]|) {
		act();
	}
:type l%
	if(arr[getIdx()]) {
		act();
	|}
:type k$h%
	if(arr[getIdx()]) {
		act|();
	}
:type kh%
	if(arr[getIdx()|]) {
		act();
	}
:end

:start Motion | (counts screen columns, tabs are wide)
:set tabstop=8
		Lo|rem ipsum
:type 1|
	|	Lorem ipsum
:type 5|
	|	Lorem ipsum
:type 10|
		L|orem ipsum
:end
