# This file is part of vim-unit: Unit tests for vim imitators
#
# Commands from the lower levels with a non-default value of an option that
# commonly differs between editors: 'ignorecase', 'smartcase', 'wrapscan',
# 'joinspaces', 'nrformats' and 'startofline'.

:start Search / (fails at the end with nowrapscan)
:set nowrapscan
	Lorem ipsum
	dolor |sit amet
:type /ipsum\<CR>
	Lorem ipsum
	dolor |sit amet
:type /amet\<CR>
	Lorem ipsum
	dolor sit |amet
:type n
	Lorem ipsum
	dolor sit |amet
:end

:start Search / (ignorecase and smartcase)
:set ignorecase smartcase wrapscan
	|Lorem LOREM lorem ipsum
:type /lorem\<CR>
	Lorem |LOREM lorem ipsum
:type n
	Lorem LOREM |lorem ipsum
:type /Lorem\<CR>
	|Lorem LOREM lorem ipsum
:end

:start Command J (with joinspaces)
:set joinspaces
	|Lorem.
	Ipsum?
	Dolor!
	Sit,
	amet
:type 5J
	Lorem.  Ipsum?  Dolor!  Sit,| amet
:end

:start Command * (with nowrapscan, at the last match fails)
:set nowrapscan noignorecase
	lorem ipsum
	dolor |lorem
:type *
	lorem ipsum
	dolor |lorem
:type #
	|lorem ipsum
	dolor lorem
:end

:start Command * (uses ignorecase but not smartcase)
:set wrapscan ignorecase smartcase
	|Lorem lorem LOREM ipsum
:type *
	Lorem |lorem LOREM ipsum
:type *
	Lorem lorem |LOREM ipsum
:end

:start Command CTRL-A (leading zeros with octal)
:set nrformats=bin,octal,hex
	|007 08 -010
:type \<C-A>
	01|0 08 -010
:type w\<C-A>
	010 |9 -010
:type w\<C-A>
	010 9 -01|1
:end

:start Motion G and gg (nostartofline keeps the column)
:set nostartofline
	Lorem ip|sum
	dolor
	sit amet consectetur
:type G
	Lorem ipsum
	dolor
	sit amet| consectetur
:type gg
	Lorem ip|sum
	dolor
	sit amet consectetur
:type 2G
	Lorem ipsum
	dolo|r
	sit amet consectetur
:type G
	Lorem ipsum
	dolor
	sit amet| consectetur
:end
