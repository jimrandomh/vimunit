# This file is part of vim-unit: Unit tests for vim imitators

:start Motion h (left, single)
	Lorem ipsum
	d|olor sit amet.
:type h
	Lorem ipsum
	|dolor sit amet.
:type h
	Lorem ipsum
	|dolor sit amet.
:end

:start Motion j (down, single)
	L|orem ipsum
	dolor sit amet.
:type j
	Lorem ipsum
	d|olor sit amet.
:type j
	Lorem ipsum
	d|olor sit amet.
:end

:start Motion k (up, single)
	Lorem ipsum
	d|olor sit amet
:type k
	L|orem ipsum
	dolor sit amet
:end

:start Motion l (right, single)
	Lorem ips|um
	dolor sit amet
:type l
	Lorem ipsu|m
	dolor sit amet
:type l
	Lorem ipsu|m
	dolor sit amet
:end

:start Command dd (delete line)
	|Lorem ipsum
	dolor sit amet
:type dd
	|dolor sit amet
:end

:start Insert mode
	Hello|!
:type i, World\<Esc>lll
	Hello, World|!
:end

:start Motions j and k (remember the column across shorter and empty lines)
	Lorem ips|um
	dolor

	sit amet consectetur
:type j
	Lorem ipsum
	dolo|r

	sit amet consectetur
:type j
	Lorem ipsum
	dolor
	|
	sit amet consectetur
:type j
	Lorem ipsum
	dolor

	sit amet |consectetur
:type k
	Lorem ipsum
	dolor
	|
	sit amet consectetur
:type kk
	Lorem ips|um
	dolor

	sit amet consectetur
:end

:start Motion k (at the first line fails; later keys still run)
	Lo|rem
	ipsum
:type kl
	Lor|em
	ipsum
:end

:start Command dd (on the last line)
:set startofline
	Lorem
	  ipsum
	do|lor
:type dd
	Lorem
	  |ipsum
:type dd
	|Lorem
:end

:start Command dd (on the only line)
	Lorem |ipsum
:type dd
	|
:type dd
	|
:end

:start Insert mode (Esc moves the cursor left, but not past the start of the line)
	Lorem
	|ipsum
:type iab\<Esc>
	Lorem
	a|bipsum
:type hi\<Esc>
	Lorem
	|abipsum
:end
